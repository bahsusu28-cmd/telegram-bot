{
  "version": 2,
  "public": true,
  "buildCommand": "echo 'Building v2.0'",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/webapp/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
